{
  "name": "shuimo-design",
  "description": "一款粗暴的水墨风UI组件",
  "author": "阿怪 <higuaifan@higuaifan.com>",
  "license": "MIT",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm -C playground run dev",
    "build": "pnpm -C cli/build run build",
    "test": "pnpm -C lib run test",
    "coverage": "pnpm -C lib run coverage",
    "doc:dev": "pnpm -C doc run doc:dev",
    "doc:build": "pnpm -C doc run build",
    "clean:node_modules": "rimraf --glob node_modules **/*/node_modules",
    "re-install": "pnpm run clean:node_modules && pnpm i",
    "lint": "jhlint",
    "prepare": "jhlint install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janghood/shuimo-ui.git"
  },
  "bugs": {
    "url": "https://github.com/janghood/shuimo-ui/issues"
  },
  "homepage": "https://shuimo.design",
  "web-types": "web-types.json",
  "vetur": {
    "tags": "tags.json",
    "attributes": "attributes.json"
  },
  "devDependencies": {
    "@janghood/config": "0.0.1-5",
    "@janghood/lint": "0.0.5",
    "@nuxt/devtools": "latest",
    "@types/node": "^20.12.13",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vitest/browser-playwright": "^4.0.18",
    "nuxt": "^3.11.2",
    "rimraf": "^5.0.7",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.12",
    "vitest": "^4.0.18",
    "vitest-browser-vue": "^2.0.2",
    "vue": "^3.4.27"
  }
}
